# ============================================================================
# Neviso (nevisoai.ir) — environment template (ARD §14)
# Copy to .env and fill real values. NEVER commit a real .env.
# Every variable below is validated on boot (apps/api, apps/worker).
# ============================================================================

# --- Core ---
NODE_ENV=development
APP_PORT=3000
DATABASE_URL=postgresql://neviso:neviso@localhost:5432/neviso?schema=public
REDIS_URL=redis://localhost:6379

# --- User JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# --- Admin JWT + challenge ---
JWT_ADMIN_ACCESS_SECRET=change-me-admin-access-secret
JWT_ADMIN_REFRESH_SECRET=change-me-admin-refresh-secret
JWT_ADMIN_CHALLENGE_SECRET=change-me-admin-challenge-secret
JWT_ADMIN_ACCESS_EXPIRES=15m
JWT_ADMIN_REFRESH_EXPIRES=8h
ADMIN_OTP_TTL=300
ADMIN_LOGIN_CHALLENGE_TTL=300
IMPERSONATION_TOKEN_TTL=1800
ADMIN_WEB_ORIGIN=https://admin.nevisoai.ir
# comma-separated CIDRs; empty = allow all
ADMIN_IP_ALLOWLIST=

# --- OTP: SMS Web Service ---
SMS_WEBSERVICE_BASE_URL=https://api.sms-webservice.com/api/V3
SMS_WEBSERVICE_API_KEY=
SMS_WEBSERVICE_OTP_TEMPLATE_KEY=

# --- OTP: Bale Safir ---
BALE_BASE_URL=https://safir.bale.ai/api/v2
BALE_CLIENT_ID=
BALE_CLIENT_SECRET=

# OTP rate limit / TTL
OTP_TTL=120
OTP_RATE_LIMIT_WINDOW=120

# --- Arvan Object Storage ---
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_BUCKET_UPLOADS=neviso-uploads
ARVAN_BUCKET_EXPORTS=neviso-exports

# --- Metis AI gateway ---
METIS_BASE_URL=https://api.metisai.ir
METIS_API_KEY=tpsg-...
METIS_GEMINI_MODEL=gemini-2.5-pro
METIS_EMBEDDING_PROVIDER=openai
METIS_EMBEDDING_MODEL=text-embedding-3-small
METIS_GEN_TIMEOUT=180000
METIS_IO_TIMEOUT=60000

# --- Zarinpal ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --- Credits ---
FREE_CREDIT_GRANT=20
CREDIT_COST_PER_AUDIO_MINUTE=1
CREDIT_COST_PER_IMAGE=2
CREDIT_COST_PER_CHAT_MESSAGE=1

# --- PDF export (worker) ---
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PDF_WATERMARK_TEXT=نویسو | nevisoai.ir

# --- Seed: first SUPER_ADMIN (used only by `npm run seed`; no public sign-up) ---
SEED_SUPER_ADMIN_EMAIL=admin@nevisoai.ir
SEED_SUPER_ADMIN_PASSWORD=change-me-strong-password
SEED_SUPER_ADMIN_MOBILE=09120000000
SEED_SUPER_ADMIN_NAME=مدیر ارشد
