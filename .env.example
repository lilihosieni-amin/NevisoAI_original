# ─────────────────────────────────────────────────────────────
# Neviso environment (ARD §14). Copy to .env and fill real values.
# NEVER commit real secrets — these are placeholders only.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_PORT=3000
GRAPHQL_ENDPOINT=http://localhost:3000/graphql
WEB_ORIGIN=http://localhost:4000

# Database
DATABASE_URL=postgresql://neviso:neviso@localhost:5432/neviso?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (user)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Admin JWT (Backoffice — separate secrets)
JWT_ADMIN_ACCESS_SECRET=dev-admin-access-secret-change-me
JWT_ADMIN_REFRESH_SECRET=dev-admin-refresh-secret-change-me
JWT_ADMIN_CHALLENGE_SECRET=dev-admin-challenge-secret-change-me
JWT_ADMIN_ACCESS_EXPIRES=15m
JWT_ADMIN_REFRESH_EXPIRES=8h
ADMIN_OTP_TTL=300
ADMIN_LOGIN_CHALLENGE_TTL=300
IMPERSONATION_TOKEN_TTL=1800
ADMIN_WEB_ORIGIN=http://localhost:5000
# Optional: comma-separated CIDR allowlist for the admin subdomain (empty = allow all)
ADMIN_IP_ALLOWLIST=

# OTP SMS — SMS Web Service (sms-webservice.com)
SMS_WEBSERVICE_BASE_URL=https://api.sms-webservice.com/api/V3
SMS_WEBSERVICE_API_KEY=
SMS_WEBSERVICE_OTP_TEMPLATE_KEY=

# OTP Messenger — Bale (bale.ai) Safir API
BALE_BASE_URL=https://safir.bale.ai/api/v2
BALE_CLIENT_ID=
BALE_CLIENT_SECRET=

# Arvan Object Storage
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
ARVAN_BUCKET_UPLOADS=neviso-uploads
ARVAN_BUCKET_EXPORTS=neviso-exports

# AI Provider — Gemini via Metis (متیس)
METIS_BASE_URL=https://api.metisai.ir
METIS_API_KEY=
METIS_GEMINI_MODEL=gemini-2.5-pro
METIS_EMBEDDING_PROVIDER=openai
METIS_EMBEDDING_MODEL=text-embedding-3-small
METIS_GEN_TIMEOUT=180000
METIS_IO_TIMEOUT=60000

# Worker scaling & concurrency (ARD §6.5)
WORKER_CONCURRENCY=10
METIS_MAX_CONCURRENCY=50
USER_MAX_INFLIGHT_JOBS=3

# Zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Credits
FREE_CREDIT_GRANT=60
CREDIT_COST_PER_AUDIO_MINUTE=1
CREDIT_COST_PER_IMAGE=2
CREDIT_COST_PER_CHAT_MESSAGE=10

# Puppeteer (PDF export — later step)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PDF_WATERMARK_TEXT=نویسو | nevisoai.ir

# Seed (local dev only) — first SUPER_ADMIN
SEED_SUPER_ADMIN_MOBILE=9120000000
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!123
