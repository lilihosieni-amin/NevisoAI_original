// Neviso database schema.
//
// Phase 0 establishes the Postgres connection and enables the `pgvector`
// extension (needed later for NoteChunk embeddings). Application models are
// added in the phase that first needs them (working agreement) — see the
// full target schema in .claude/skills/backend.md §3.

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

/// Foundational key/value application settings (ARD §3 / skill §3).
/// The earliest config the platform reads (e.g. "otp.channels"). Defined in
/// Phase 0 because Prisma requires at least one model to generate a client;
/// it is the lowest-level, non-feature table in the schema. Phase 1 only
/// seeds rows into it — the model is already here.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 1 — Auth (OTP), profile, credits ledger, admin auth (ARD §5.2, §7).
// Models are added in the phase that first needs them (working agreement).
// The full target schema lives in .claude/skills/backend.md §3.
// ─────────────────────────────────────────────────────────────────────────

/// An end user of the platform. Created on first successful OTP verify.
model User {
  id                  String              @id @default(uuid())
  mobile              String              @unique
  passwordHash        String?
  displayName         String?
  avatarUrl           String?
  creditBalance       Int                 @default(0)
  freeCreditsGiven    Boolean             @default(false)
  status              UserStatus          @default(ACTIVE)
  statusReason        String?
  suspendedUntil      DateTime?
  preferredOtpChannel OtpChannel?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  otpRecords          OtpRecord[]
  transactions        CreditTransaction[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

/// A single issued OTP. The code is generated by Neviso in all cases; only the
/// delivery channel differs (ARD §7.2). Redis holds the live TTL; this row is
/// the durable record + status-tracking handle (`smsMessageId`).
model OtpRecord {
  id           String     @id @default(uuid())
  userId       String?
  mobile       String
  code         String
  channel      OtpChannel @default(SMS)
  smsMessageId String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
  user         User?      @relation(fields: [userId], references: [id])

  @@index([mobile, createdAt(sort: Desc)])
  @@map("otp_records")
}

enum OtpChannel {
  SMS
  BALE
}

/// Immutable credit ledger. Every balance change is one row; user-scoped
/// operations are made idempotent via `idempotencyKey` (ARD §6.4.2).
model CreditTransaction {
  id             String          @id @default(uuid())
  userId         String
  type           TransactionType
  amount         Int
  description    String?
  refId          String?
  idempotencyKey String?         @unique
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("credit_transactions")
}

enum TransactionType {
  PURCHASE
  USAGE
  FREE_GRANT
  REFUND
  ADMIN_ADJUSTMENT
}

/// Backoffice operator. First SUPER_ADMIN is seeded (no public admin sign-up).
model Admin {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  mobile       String
  displayName  String
  role         AdminRole  @default(SUPPORT)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  otps         AdminOtp[]
  auditLogs    AuditLog[]

  @@map("admins")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

/// Step-1→step-2 admin login challenge + its one-time OTP code (ARD §7.5).
model AdminOtp {
  id          String    @id @default(uuid())
  adminId     String
  challengeId String    @unique
  code        String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  admin       Admin     @relation(fields: [adminId], references: [id])

  @@map("admin_otps")
}

/// Append-only record of state-changing admin actions (ARD §7.6). Phase 1
/// only writes ADMIN_LOGIN; later phases add more actions and queries.
model AuditLog {
  id         String      @id @default(uuid())
  adminId    String
  action     AuditAction
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  admin      Admin       @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

enum AuditAction {
  ADMIN_LOGIN
  USER_CREDIT_ADJUST
  USER_SUSPEND
  USER_BAN
  USER_REACTIVATE
  USER_IMPERSONATE_START
  USER_IMPERSONATE_END
  SUBSCRIPTION_GRANT
  SUBSCRIPTION_CANCEL
  PLAN_CREATE
  PLAN_UPDATE
  PLAN_SET_ACTIVE
  ADMIN_CREATE
  ADMIN_UPDATE_ROLE
  ADMIN_DEACTIVATE
  OTP_CHANNEL_CONFIG
}
