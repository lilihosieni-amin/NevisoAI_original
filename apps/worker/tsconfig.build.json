{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // See apps/api/tsconfig.build.json: disable incremental so Nest's
    // deleteOutDir + full emit always produces dist/main (avoids the stale
    // tsbuildinfo "Cannot find module dist/main" failure).
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "**/*.int-spec.ts"]
}
